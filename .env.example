# Copie este arquivo para .env e preencha os segredos antes de iniciar.
# Nunca envie o arquivo .env ao GitHub.
# Os nomes abaixo nao trazem valor. Nao cole token neste exemplo.
N8N_ENCRYPTION_KEY=substitua-por-uma-chave-aleatoria-longa

# Fuso horario usado nos registros e agendamentos.
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# Token do admin (Authorization: Bearer). A API nao sobe com menos de 24 caracteres.
ADMIN_TOKEN=

# App Secret da Meta. O gateway valida X-Hub-Signature-256 com este valor
# e nao sobe se estiver vazio.
META_APP_SECRET=

# Token do endpoint interno POST /interno/mensagem (Authorization: Bearer).
# A API nao sobe com menos de 24 caracteres. O gateway e o simulador enviam
# este valor como Authorization: Bearer ao webhook do n8n. O fluxo so repassa
# o cabecalho e o n8n nao le este valor.
API_INTERNAL_TOKEN=

# Codigo do evento usado nas mensagens do WhatsApp. Vazio: o unico evento com vendas abertas.
WHATSAPP_EVENTO_CODIGO=

# Tentativas da fila antes de marcar falhou. Padrao 30. O teto do backoff e 300 segundos.
FILA_MAX_TENTATIVAS=30

# Dias para apagar o corpo bruto dos eventos que falharam. Os metadados ficam. Padrao 7.
FILA_RETENCAO_DIAS=7

# 1 liga GET /, GET /simulador e POST /simular-mensagem. Qualquer outro valor responde 404.
SIMULADOR_ATIVO=

# Variaveis da API. Vazio usa o padrao do codigo, exceto os segredos acima.
API_DATABASE_PATH=
API_HOST=127.0.0.1
API_PORT=8000
# Use 127.0.0.1 no dia a dia. O fallback do codigo tambem e 127.0.0.1.
# 0.0.0.0 so para teste na rede. POST /atendimentos nao responde no HTTPS.
# POST /interno/* tambem nao. Um https.env antigo pode continuar em 0.0.0.0
# ate rodar scripts/configurar-https-local.ps1 de novo.
API_HTTPS_HOST=127.0.0.1
API_HTTPS_PORT=8443
API_TLS_CERT_PATH=
API_TLS_KEY_PATH=
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/whatsapp-mensagens
# Opcional. A API avisa esta URL quando um lote vira ou o evento esgota.
# Se estiver vazia ou o n8n fora do ar, a aprovacao do pagamento continua valida.
N8N_VIRADA_LOTE_WEBHOOK_URL=

# Token da WhatsApp Cloud API. Fica so no processo da API. Sem ele, a API sobe
# e o ciclo de envio fica desligado. Com valor, exige pelo menos 24 caracteres
# e META_PHONE_NUMBER_ID. Nao vai para o n8n nem para o gateway.
META_ACCESS_TOKEN=

# ID do numero na Cloud API. Obrigatorio quando META_ACCESS_TOKEN esta preenchido.
META_PHONE_NUMBER_ID=

# Versao da Graph, no formato v22.0. Vazio desliga o envio. A versao vigente
# da Meta nao foi confirmada nesta tarefa; nao ha padrao cravado no codigo.
META_GRAPH_VERSION=

# Base da Graph. Vazio usa https://graph.facebook.com. http so e aceito em 127.0.0.1.
META_GRAPH_BASE_URL=

# Tentativas de envio depois de 429 ou 5xx. Padrao 30. O backoff e 2^tentativas
# segundos, com teto de 300.
ENVIO_MAX_TENTATIVAS=

# Dias depois da data do evento para apagar o arquivo de comprovante aprovado. Padrao 30.
COMPROVANTE_RETENCAO_DIAS_APROVADO=

# Dias depois da recusa, expiracao ou cancelamento para apagar o arquivo. Padrao 7.
COMPROVANTE_RETENCAO_DIAS_RECUSADO=

