{
  "id": "webhookWhatsapp0001",
  "name": "04 - Webhook de WhatsApp simulado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-mensagens",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "9b1748fc-7728-4071-a5a0-5222de4c8f86",
      "name": "Receber mensagem externa",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-440, 0],
      "webhookId": "452a04bc-b09c-4da4-a0d5-dd97c76f7217"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ (Number(($json.body || {}).usar_porta_teste) === 1 && /^\\d+$/.test(String(($json.body || {}).porta_api || ''))) ? ('http://127.0.0.1:' + String($json.body.porta_api) + '/interno/mensagem') : 'http://127.0.0.1:8000/interno/mensagem' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $json.headers.authorization || '' }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "5431bc11-7ec5-4667-8fbb-7fe27fe04ed5",
      "name": "Chamar API interna",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-120, 0],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": {
          "responseCode": "={{ Number($json.statusCode) || 502 }}"
        }
      },
      "id": "31a8f8bf-51f8-4094-a87e-b2ebad3977b1",
      "name": "Devolver resposta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [200, -80]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { erro: 'O n8n nao conseguiu falar com a API.' } }}",
        "options": {
          "responseCode": 502
        }
      },
      "id": "a1c0e5d2-6b47-4f0a-9c31-0e5d4a7b8c90",
      "name": "Devolver erro de rede",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [200, 120]
    }
  ],
  "connections": {
    "Receber mensagem externa": {
      "main": [[{ "node": "Chamar API interna", "type": "main", "index": 0 }]]
    },
    "Chamar API interna": {
      "main": [
        [{ "node": "Devolver resposta", "type": "main", "index": 0 }],
        [{ "node": "Devolver erro de rede", "type": "main", "index": 0 }]
      ]
    }
  },
  "pinData": {},
